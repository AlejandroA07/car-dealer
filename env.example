# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real credentials.

# PostgreSQL password (used by Docker Compose and must match your API user secret)
POSTGRES_PASSWORD=change-me

# JWT signing secret — minimum 32 characters
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Signing secret for guest booking email-verification tokens (OTP session /
# verified-email tokens) — minimum 32 characters, keep distinct from JWT_SECRET
GUEST_VERIFICATION_SECRET=change-me-to-a-different-long-random-string-at-least-32-chars

# Admin seed account password
ADMIN_PASSWORD=change-me

# Public URL of the deployed Web app (used to build email confirmation links).
# Only needed for the VPS deploy overlay — leave unset for local dev/docker.
WEB_BASE_URL=change-me-to-your-deployed-web-url

# Outgoing SMTP for registration/booking-verification emails — OPTIONAL for local
# dev: leave EMAIL_SMTP_HOST blank (as below) and the app automatically logs
# confirmation links / verification codes to the console instead of emailing them,
# so you can complete the register/confirm and guest-booking flows with zero setup.
# REQUIRED for any deployment outside Development (the app fails fast at startup
# if this is blank there) — fill in all five values below to enable real sending.
#
# Free option with no domain required: Brevo (https://brevo.com, free tier,
# 300 emails/day).
#   1. Sign up, then Senders, Domains & Dedicated IPs -> Senders -> Add a New
#      Sender using any email address you can receive mail at (no domain
#      needed) and click the verification link Brevo emails you.
#   2. Profile icon -> SMTP & API -> SMTP tab -> note the Login shown there,
#      then "Generate a new SMTP key" and copy it immediately (shown once).
# EMAIL_SMTP_USERNAME is the Login from step 2 (a Brevo-generated address,
# not your own email). EMAIL_FROM_ADDRESS is the sender you verified in step 1.
# EMAIL_SMTP_HOST/PORT for Brevo: smtp-relay.brevo.com / 587
# Note: without a fully authenticated domain (SPF/DKIM), some mail may
# occasionally land in spam for Gmail/Yahoo/Outlook recipients — acceptable
# for low-volume/portfolio use, not recommended for real bulk sending.
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=
