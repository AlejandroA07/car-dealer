@model westcoast_cars.web.ViewModels.Admin.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin";
    var maxStock = Math.Max(Model.StockByManufacturer.Any() ? Model.StockByManufacturer.Max(x => x.Count) : 1, 1);
    var recentVehicles = Model.RecentVehicles.Take(3).ToList();
}

<section class="admin-dashboard-page">
    <div class="site-container admin-workspace-container">
        @await Html.PartialAsync("_AdminSidebar")

        <div class="admin-workspace-main admin-dashboard-container">
            <header class="admin-dashboard-header">
                <div>
                    <span class="eyebrow">Administrativ överblick</span>
                    <h1>Lagerdashboard</h1>
                </div>

                <div class="admin-dashboard-actions" aria-label="Snabbåtgärder">
                    <a asp-action="SyncBlocket" asp-controller="Vehicles" class="btn btn-primary">
                        <i class="fa-solid fa-rotate"></i> Synka Blocket
                    </a>
                    <a asp-action="Create" asp-controller="Vehicles" class="btn btn-secondary">
                        <i class="fa-solid fa-plus"></i> Lägg till bil
                    </a>
                    <a asp-action="Create" asp-controller="Manufacturer" class="btn btn-secondary">
                        <i class="fa-solid fa-building"></i> Lägg till tillverkare
                    </a>
                </div>
            </header>

        <section class="admin-metric-grid" aria-label="Lagerstatistik">
            <article class="admin-metric-card">
                <div class="admin-metric-topline">
                    <span class="admin-metric-icon"><i class="fa-solid fa-car-side"></i></span>
                    <small>Lager</small>
                </div>
                <span>Totala bilar</span>
                <strong>@Model.TotalVehicles</strong>
            </article>

            <article class="admin-metric-card">
                <div class="admin-metric-topline">
                    <span class="admin-metric-icon admin-metric-icon-muted"><i class="fa-solid fa-circle-check"></i></span>
                    <small>Stabilt</small>
                </div>
                <span>Tillgängliga</span>
                <strong>@Model.AvailableVehicles</strong>
            </article>

            <article class="admin-metric-card">
                <div class="admin-metric-topline">
                    <span class="admin-metric-icon admin-metric-icon-sale"><i class="fa-solid fa-tag"></i></span>
                    <small>Avslut</small>
                </div>
                <span>Sålda</span>
                <strong>@Model.SoldVehicles</strong>
            </article>

            <article class="admin-metric-card">
                <div class="admin-metric-topline">
                    <span class="admin-metric-icon"><i class="fa-solid fa-money-bill-wave"></i></span>
                    <small>Premium</small>
                </div>
                <span>Lagervärde</span>
                <strong>@Model.TotalInventoryValue.ToString("N0") kr</strong>
            </article>
        </section>

        <section class="admin-dashboard-main">
            <article class="admin-stock-card">
                <h2>Lagerfördelning</h2>

                @if (Model.StockByManufacturer.Any())
                {
                    <div class="admin-stock-list">
                        @foreach (var item in Model.StockByManufacturer.Take(6))
                        {
                            var width = Math.Max(8, (int)Math.Round((item.Count / (double)maxStock) * 100));
                            <div class="admin-stock-item">
                                <div class="admin-stock-row">
                                    <span>@item.Name</span>
                                    <small>@item.Count st</small>
                                </div>
                                <div class="admin-stock-track" aria-hidden="true">
                                    <span style="width: @width%"></span>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="admin-empty-copy">Inga lagerdata ännu.</p>
                }

                <div class="admin-online-row">
                    <span class="admin-avatar-stack" aria-hidden="true">
                        <span></span><span></span><span></span>
                    </span>
                    <p>Aktiv adminpanel</p>
                </div>
            </article>

            <article class="admin-recent-card">
                <div class="admin-card-header">
                    <h2>Senaste bilar</h2>
                    <a asp-route="VehicleCatalog">Visa alla</a>
                </div>

                @if (recentVehicles.Any())
                {
                    <div class="admin-recent-list">
                        @foreach (var vehicle in recentVehicles)
                        {
                            var vehicleStatus = vehicle.IsSold ? "Såld" : "Ny i lager";
                            var listedText = vehicle.PublishedAt.HasValue
                                ? vehicle.PublishedAt.Value.ToLocalTime().ToString("yyyy-MM-dd")
                                : "Ej publicerad";
                            var vehicleTitle = string.IsNullOrWhiteSpace(vehicle.Name)
                                ? $"{vehicle.Manufacturer} {vehicle.Model}".Trim()
                                : vehicle.Name;

                            <a asp-action="Details" asp-controller="Vehicles" asp-route-id="@vehicle.Id" class="admin-recent-row">
                                <div class="admin-recent-image">
                                    @if (!string.IsNullOrWhiteSpace(vehicle.ImageUrl))
                                    {
                                        <img src="@vehicle.ImageUrl" alt="@vehicleTitle" />
                                    }
                                    else
                                    {
                                        <i class="fa-solid fa-car-side"></i>
                                    }
                                </div>
                                <div class="admin-recent-copy">
                                    <div>
                                        <span class="admin-status-pill @(vehicle.IsSold ? "is-sold" : "")">@vehicleStatus</span>
                                        <small>Ref: #WC-@vehicle.Id</small>
                                    </div>
                                    <strong>@vehicle.ModelYear @vehicleTitle</strong>
                                    <p>@vehicle.Model · @(string.IsNullOrWhiteSpace(vehicle.Color) ? "Färg ej angiven" : vehicle.Color)</p>
                                </div>
                                <div class="admin-recent-price">
                                    <strong>@vehicle.Value.ToString("N0") kr</strong>
                                    <small>@listedText</small>
                                </div>
                            </a>
                        }
                    </div>
                }
                else
                {
                    <p class="admin-empty-copy">Inga bilar har lagts till ännu.</p>
                }
            </article>
        </section>

        </div>
    </div>
</section>
