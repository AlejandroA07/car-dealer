
@model WestcoastCars.Contracts.DTOs.VehicleDetailsDto

<article class="page">
    <section class="vehicle-detail-container">
        <div class="vehicle-detail">
            <span class="back-icon">
                <a asp-action="index"><span><i class="fa-regular fa-arrow-left-long"></i> Tillbaka</span></a>
            </span>
            <h2 class="vehicle-detail-header">@Model.Manufacturer - @Model.Model</h2>
            <img src="@Model.ImageUrl" alt="@Model.Model">
            <div class="vehicle-detail-info">
                <span><strong>Modell</strong></span>
                <span>@Model.Model</span>
                <span><strong>Årsmodel</strong></span>
                <span>@Model.ModelYear</span>
                <span><strong>Km</strong></span>
                <span>@Model.Mileage</span>
                <span><strong>Pris</strong></span>
                <span>@Model.Value</span>
            </div>
            <div class="vehicle-detail-grid">
                <span><strong>Registration number</strong></span>
                <span>@(string.IsNullOrWhiteSpace(Model.RegistrationNumber) ? "Not available" : Model.RegistrationNumber)</span>
                <span><strong>Fuel</strong></span>
                <span>@Model.FuelType</span>
                <span><strong>Transmission</strong></span>
                <span>@Model.TransmissionsType</span>
                <span><strong>Color</strong></span>
                <span>@(string.IsNullOrWhiteSpace(Model.Color) ? "Not available" : Model.Color)</span>
                <span><strong>City</strong></span>
                <span>@(string.IsNullOrWhiteSpace(Model.City) ? "Not available" : Model.City)</span>
                <span><strong>Published</strong></span>
                <span>@(Model.PublishedAt.HasValue ? Model.PublishedAt.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm") : "Not available")</span>
                <span><strong>Imported</strong></span>
                <span>@(Model.ImportedAt.HasValue ? Model.ImportedAt.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm") : "Not available")</span>
                <span><strong>Source</strong></span>
                <span>@(string.IsNullOrWhiteSpace(Model.Source) ? "Manual inventory" : Model.Source)</span>
                <span><strong>Listing link</strong></span>
                <span>
                    @if (string.IsNullOrWhiteSpace(Model.SourceUrl))
                    {
                        @:Not available
                    }
                    else
                    {
                        <a href="@Model.SourceUrl" target="_blank" rel="noopener noreferrer">Open original listing</a>
                    }
                </span>
            </div>
            <h4>Beskrivning</h4>
            <div>@Model.Description</div>
        </div>
        
    </section>
    
</article>
