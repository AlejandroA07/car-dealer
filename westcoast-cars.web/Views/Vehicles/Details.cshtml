@model WestcoastCars.Contracts.DTOs.VehicleDetailsDto
@{
    ViewData["Title"] = $"{Model.Manufacturer} {Model.Model}";
}

<section class="section-block site-container">
    <div class="vehicle-detail-shell">
        <div class="vehicle-detail-main card-surface">
            <a asp-action="Index" class="text-link back-link"><i class="fa-solid fa-arrow-left-long"></i> Tillbaka till lagret</a>

            <div class="vehicle-detail-header-row">
                <div>
                    <span class="eyebrow">@Model.Manufacturer</span>
                    <h1>@Model.Name</h1>
                    <p class="vehicle-detail-subtitle">@Model.Model · @Model.ModelYear</p>
                </div>
                <div class="vehicle-price-card">
                    <span>Pris</span>
                    <strong>@Model.Value.ToString("N0") kr</strong>
                    <small>@(Model.IsSold ? "Såld" : "Tillgänglig för visning")</small>
                </div>
            </div>

            <div class="vehicle-hero-image">
                <img src="@Model.ImageUrl" alt="@($"{Model.Manufacturer} {Model.Model}")" />
            </div>

            <div class="vehicle-highlight-grid">
                <div class="detail-highlight">
                    <span>Årsmodell</span>
                    <strong>@Model.ModelYear</strong>
                </div>
                <div class="detail-highlight">
                    <span>Miltal</span>
                    <strong>@Model.Mileage.ToString("N0") km</strong>
                </div>
                <div class="detail-highlight">
                    <span>Bränsle</span>
                    <strong>@Model.FuelType</strong>
                </div>
                <div class="detail-highlight">
                    <span>Växellåda</span>
                    <strong>@Model.TransmissionsType</strong>
                </div>
            </div>

            <div class="detail-info-grid">
                <div class="detail-row"><span>Registreringsnummer</span><strong>@(string.IsNullOrWhiteSpace(Model.RegistrationNumber) ? "Ej tillgängligt" : Model.RegistrationNumber)</strong></div>
                <div class="detail-row"><span>Färg</span><strong>@(string.IsNullOrWhiteSpace(Model.Color) ? "Ej angivet" : Model.Color)</strong></div>
                <div class="detail-row"><span>Ort</span><strong>@(string.IsNullOrWhiteSpace(Model.City) ? "Ej angivet" : Model.City)</strong></div>
                <div class="detail-row"><span>Publicerad</span><strong>@(Model.PublishedAt.HasValue ? Model.PublishedAt.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm") : "Ej tillgängligt")</strong></div>
                <div class="detail-row"><span>Importerad</span><strong>@(Model.ImportedAt.HasValue ? Model.ImportedAt.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm") : "Ej tillgängligt")</strong></div>
                <div class="detail-row"><span>Källa</span><strong>@(string.IsNullOrWhiteSpace(Model.Source) ? "Manuellt lager" : Model.Source)</strong></div>
            </div>

            <div class="detail-description card-surface card-surface-subtle">
                <span class="eyebrow">Beskrivning</span>
                <p>@(string.IsNullOrWhiteSpace(Model.Description) ? "Ingen beskrivning tillgänglig ännu." : Model.Description)</p>
            </div>
        </div>

        <aside class="vehicle-detail-sidebar card-surface">
            <span class="eyebrow">Nästa steg</span>
            <h2>Redo att ta nästa steg?</h2>
            <p>Ta kontakt med teamet för provkörning, finansieringsfrågor eller mer information om bilen.</p>

            @if (!string.IsNullOrWhiteSpace(Model.SourceUrl))
            {
                <a href="@Model.SourceUrl" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-full">Öppna originalannons</a>
            }

            <a asp-action="Index" asp-controller="Service" class="btn btn-ghost btn-full">Boka service eller rådgivning</a>
        </aside>
    </div>
</section>
