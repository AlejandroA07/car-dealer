{
  "JwtSettings": {
    "Issuer": "WestcoastCars.Auth",
    "Audience": "WestcoastCars.Auth",
    "ExpiryMinutes": 60
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=db;Port=3306;Database=westcoast_cars_db;Uid=root;Pwd=${MYSQL_PASSWORD};"
  },
  "BlocketApi": {
    "BaseUrl": "https://blocket-api.se/",
    "TimeoutSeconds": 30,
    "DefaultSortOrder": "PUBLISHED_DESC"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
