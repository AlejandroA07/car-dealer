{
  "JwtSettings": {
    "Issuer": "WestcoastCars.Auth",
    "Audience": "WestcoastCars.Auth",
    "ExpiryMinutes": 60
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=db;Port=5432;Database=westcoast_cars;Username=postgres;Password=${POSTGRES_PASSWORD};"
  },
  "AdminSettings": {
    "Password": ""
  },
  "BlocketApi": {
    "BaseUrl": "https://blocket-api.se/",
    "TimeoutSeconds": 30,
    "DefaultSortOrder": "PUBLISHED_DESC"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
