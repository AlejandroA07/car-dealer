{
  "App": {
    "BaseUrl": "http://localhost:5002"
  },
  "BlocketApi": {
    "BaseUrl": "https://blocket-api.se/",
    "TimeoutSeconds": 30,
    "DefaultSortOrder": "PUBLISHED_DESC",
    "MinRequestIntervalMilliseconds": 300,
    "MaxRetries": 3
  },
  "apiImageUrl": "http://localhost:5001/images/",
  "DataProtectionPath": "dpkeys",
  "Email": {
    "SmtpPort": 587,
    "FromName": "Westcoast Cars"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5000", "https://localhost:5001", "http://localhost:7000", "https://localhost:7001", "http://localhost:7001" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "WestcoastCars.Infrastructure.Clients.BlocketApiClient": "Debug",
      "WestcoastCars.Application.Features.Vehicles.Queries.PreviewBlocketVehicles": "Debug",
      "WestcoastCars.Application.Services.BlocketVehicleImportMapper": "Debug"
    }
  }
}
