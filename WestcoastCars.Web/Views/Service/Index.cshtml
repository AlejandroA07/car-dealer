@model WestcoastCars.Web.ViewModels.ServiceBooking.ServiceIndexViewModel

@{
    ViewData["Title"] = "Boka service";

    var today = DateOnly.FromDateTime(DateTime.Today);
    var currentMonday = today.AddDays(-((int)today.DayOfWeek - (int)DayOfWeek.Monday + 7) % 7);
    var maxMonday = currentMonday.AddDays(42);

    var prevWeek = Model.WeekStart.AddDays(-7);
    var nextWeek = Model.WeekStart.AddDays(7);
    var prevDisabled = prevWeek < currentMonday;
    var nextDisabled = nextWeek > maxMonday;

    var dayNames = new[] { "Mån", "Tis", "Ons", "Tor", "Fre" };
    var slotLabels = new[] { "Morgon (08–10)", "Förmiddag (10–12)", "Eftermiddag (13–15)" };
    int[] slotEndHours = { 10, 12, 15 };
    var nowHour = DateTime.Now.Hour;

    bool IsPast(DateOnly date, int slotIdx) =>
        date < today || (date == today && nowHour >= slotEndHours[slotIdx]);

    var slotMap = Model.WeekSlots.ToDictionary(s => (s.Date, s.TimeSlot));
}

<section class="service-appointment-page">
    <div class="site-container service-appointment-container">
        <header class="service-appointment-header">
            <h1>Servicebokning</h1>
            <p>Boka underhåll eller reparation hos våra certifierade tekniker. Tydlig process, lugn dialog och omsorg om din bil.</p>
        </header>

        <div class="service-appointment-shell">
            <aside class="service-appointment-aside" aria-label="Servicefördelar">
                <div class="service-info-card">
                    <span class="service-kicker">Nordisk kvalitet</span>
                    <p>Varje service följer en tydlig kontroll med fokus på säkerhet, precision och personlig återkoppling.</p>

                    <div class="service-benefit">
                        <i class="fa-solid fa-shield-halved"></i>
                        <div>
                            <strong>Originaldelar</strong>
                            <span>OEM-komponenter när det behövs.</span>
                        </div>
                    </div>

                    <div class="service-benefit">
                        <i class="fa-solid fa-car-side"></i>
                        <div>
                            <strong>Bokningen bekräftas direkt</strong>
                            <span>Du får en bekräftelse via e-post när bokningen lyckas.</span>
                        </div>
                    </div>
                </div>

                <div class="service-facility-card">
                    <span>State-of-the-art verkstad</span>
                </div>
            </aside>

            <form asp-action="Index" method="post" class="service-appointment-form" id="bookingForm">
                <div asp-validation-summary="ModelOnly" class="service-validation-summary"></div>

                <input type="hidden" asp-for="WeekStart" />
                <input type="hidden" asp-for="BookingForm.BookingDate" id="selectedDate" />
                <input type="hidden" asp-for="BookingForm.TimeSlot" id="selectedSlot" value="-1" />

                <section class="service-form-section">
                    <div class="service-section-title">
                        <span>01</span>
                        <h2>Bilinformation</h2>
                    </div>

                    <div class="service-field-grid">
                        <label class="service-field service-field-wide">
                            <span>Registreringsnummer / VIN</span>
                            <input asp-for="BookingForm.VehicleRegistrationNumber" placeholder="ABC 1234" autocomplete="off" />
                            <span asp-validation-for="BookingForm.VehicleRegistrationNumber" class="service-field-error"></span>
                        </label>
                    </div>
                </section>

                <section class="service-form-section">
                    <div class="service-section-title">
                        <span>02</span>
                        <h2>Servicebehov</h2>
                    </div>

                    <div class="service-choice-grid">
                        <label class="service-choice-card">
                            <input asp-for="BookingForm.ServiceType" type="radio" value="Bas-service" />
                            <span>
                                <strong>Årlig service</strong>
                                <small>Standardkontroll och oljebyte</small>
                            </span>
                            <i class="fa-regular fa-circle-check"></i>
                        </label>

                        <label class="service-choice-card">
                            <input asp-for="BookingForm.ServiceType" type="radio" value="Diagnostik" />
                            <span>
                                <strong>Diagnostik</strong>
                                <small>Motorlampa, ljud eller felkod</small>
                            </span>
                            <i class="fa-regular fa-circle"></i>
                        </label>

                        <label class="service-choice-card">
                            <input asp-for="BookingForm.ServiceType" type="radio" value="Bromsservice" />
                            <span>
                                <strong>Däck & bromsar</strong>
                                <small>Rotation, byte eller bromskontroll</small>
                            </span>
                            <i class="fa-regular fa-circle"></i>
                        </label>

                        <label class="service-choice-card">
                            <input asp-for="BookingForm.ServiceType" type="radio" value="Kaross" />
                            <span>
                                <strong>Karossarbete</strong>
                                <small>Lack, mindre skador eller restaurering</small>
                            </span>
                            <i class="fa-regular fa-circle"></i>
                        </label>
                    </div>
                    <span asp-validation-for="BookingForm.ServiceType" class="service-field-error"></span>

                    <label class="service-field service-notes-field">
                        <span>Extra information</span>
                        <textarea asp-for="BookingForm.Description" rows="4" placeholder="Berätta kort vad bilen behöver..."></textarea>
                        <span asp-validation-for="BookingForm.Description" class="service-field-error"></span>
                    </label>
                </section>

                <section class="service-form-section">
                    <div class="service-section-title">
                        <span>03</span>
                        <h2>Önskad tid</h2>
                    </div>

                    @if (Model.AvailabilityLoadFailed)
                    {
                        <p class="service-field-error">@Model.AvailabilityErrorMessage</p>
                    }

                    <div class="slot-week-nav">
                        @if (prevDisabled)
                        {
                            <span class="slot-week-nav-btn is-disabled"><i class="fa-solid fa-chevron-left"></i> Föregående</span>
                        }
                        else
                        {
                            <a class="slot-week-nav-btn" href="@Url.Action("Index", new { weekStart = prevWeek.ToString("yyyy-MM-dd") })"><i class="fa-solid fa-chevron-left"></i> Föregående</a>
                        }

                        <span class="slot-week-label">
                            @Model.WeekStart.ToString("d MMM") – @Model.WeekStart.AddDays(4).ToString("d MMM yyyy")
                        </span>

                        @if (nextDisabled)
                        {
                            <span class="slot-week-nav-btn is-disabled">Nästa <i class="fa-solid fa-chevron-right"></i></span>
                        }
                        else
                        {
                            <a class="slot-week-nav-btn" href="@Url.Action("Index", new { weekStart = nextWeek.ToString("yyyy-MM-dd") })">Nästa <i class="fa-solid fa-chevron-right"></i></a>
                        }
                    </div>

                    <div class="slot-grid-wrapper">
                        <div class="slot-grid">
                            <div></div>
                            @for (int dayIndex = 0; dayIndex < 5; dayIndex++)
                            {
                                var day = Model.WeekStart.AddDays(dayIndex);
                                <div class="slot-day-header @(day == today ? "is-today" : "")">
                                    <strong>@dayNames[dayIndex]</strong>
                                    <span>@day.Day/@day.Month</span>
                                </div>
                            }

                            @for (int slotIndex = 0; slotIndex < 3; slotIndex++)
                            {
                                <div class="slot-row-label">@slotLabels[slotIndex]</div>
                                @for (int dayIndex = 0; dayIndex < 5; dayIndex++)
                                {
                                    var day = Model.WeekStart.AddDays(dayIndex);
                                    slotMap.TryGetValue((day, slotIndex), out var slot);
                                    var isPast = IsPast(day, slotIndex);
                                    var isBooked = slot?.IsBooked == true;
                                    var stateClass = isPast
                                        ? "is-past"
                                        : (isBooked || Model.AvailabilityLoadFailed ? "is-booked" : "is-available");

                                    <button type="button"
                                            class="slot-cell @stateClass"
                                            data-date="@day.ToString("yyyy-MM-dd")"
                                            data-slot="@slotIndex"
                                            @(isPast || isBooked || Model.AvailabilityLoadFailed ? "disabled" : "")>
                                        @if (Model.AvailabilityLoadFailed)
                                        {
                                            <span>Okänd</span>
                                        }
                                        else if (isPast)
                                        {
                                            <span>Passerat</span>
                                        }
                                        else if (isBooked)
                                        {
                                            <span>Bokad</span>
                                        }
                                        else
                                        {
                                            <span>Ledig</span>
                                        }
                                    </button>
                                }
                            }
                        </div>
                    </div>

                    <p id="slotError" class="service-field-error" style="display:none">Välj ett tillgängligt tidsfönster innan du skickar.</p>
                    <span asp-validation-for="BookingForm.BookingDate" class="service-field-error"></span>
                    <span asp-validation-for="BookingForm.TimeSlot" class="service-field-error"></span>
                </section>

                <section class="service-form-section">
                    <div class="service-section-title">
                        <span>04</span>
                        <h2>Kontaktuppgifter</h2>
                    </div>

                    <div class="service-field-grid">
                        <label class="service-field">
                            <span>Fullständigt namn</span>
                            <input asp-for="BookingForm.CustomerName" placeholder="Erik Larsson" autocomplete="name" />
                            <span asp-validation-for="BookingForm.CustomerName" class="service-field-error"></span>
                        </label>

                        <label class="service-field">
                            <span>Telefonnummer</span>
                            <input asp-for="BookingForm.CustomerPhone" placeholder="+46 00 000 00 00" autocomplete="tel" />
                            <span asp-validation-for="BookingForm.CustomerPhone" class="service-field-error"></span>
                        </label>

                        <label class="service-field service-field-wide">
                            <span>E-postadress</span>
                            <input asp-for="BookingForm.CustomerEmail" type="email" placeholder="erik.larsson@example.com" autocomplete="email" />
                            <span asp-validation-for="BookingForm.CustomerEmail" class="service-field-error"></span>
                        </label>
                    </div>
                </section>

                <div class="service-submit-row">
                    <button type="submit" class="btn btn-primary service-submit-button" @(Model.AvailabilityLoadFailed ? "disabled" : "")>
                        Bekräfta bokning <i class="fa-solid fa-calendar-check"></i>
                    </button>
                    <p>Din tid bekräftas direkt när bokningen lyckas och bekräftelsen skickas till din e-post.</p>
                </div>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var dateInput = document.getElementById('selectedDate');
            var slotInput = document.getElementById('selectedSlot');
            var slotError = document.getElementById('slotError');
            var bookingForm = document.getElementById('bookingForm');

            if (!bookingForm) {
                return;
            }

            document.querySelectorAll('.slot-cell.is-available').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    document.querySelectorAll('.slot-cell').forEach(function (cell) {
                        cell.classList.remove('is-selected');
                    });
                    btn.classList.add('is-selected');
                    dateInput.value = btn.dataset.date;
                    slotInput.value = btn.dataset.slot;
                    slotError.style.display = 'none';
                });
            });

            bookingForm.addEventListener('submit', function (e) {
                if (!dateInput.value || slotInput.value === '-1') {
                    slotError.style.display = 'block';
                    e.preventDefault();
                }
            });
        })();
    </script>
}
