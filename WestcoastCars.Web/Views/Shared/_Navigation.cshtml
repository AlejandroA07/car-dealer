@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var isHome = string.Equals(currentController, "Home", StringComparison.OrdinalIgnoreCase);
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var isVehicles = string.Equals(currentController, "Vehicles", StringComparison.OrdinalIgnoreCase)
        && string.Equals(currentAction, "Index", StringComparison.OrdinalIgnoreCase);
    var isService = string.Equals(currentController, "Service", StringComparison.OrdinalIgnoreCase);
    var portalController = User.IsInRole("Admin") || User.IsInRole("Salesperson") ? "Admin" : "Home";
    var userName = User.Identity?.Name?.Split('@')[0];
}

<nav class="navbar site-container" aria-label="Huvudnavigering">
    <a asp-action="Index" asp-controller="Home" class="brand-mark" aria-label="Westcoast Cars startsida">
        <span class="brand-name">Westcoast Cars</span>
    </a>

    <ul class="nav-links" aria-label="Primär navigering">
        <li><a asp-action="Index" asp-controller="Home" class="@(isHome ? "active" : null)">Hem</a></li>
        <li><a asp-route="VehicleCatalog" class="@(isVehicles ? "active" : null)">Katalog</a></li>
        <li><a asp-action="Index" asp-controller="Service" class="@(isService ? "active" : null)">Service</a></li>
        <li><a asp-action="Index" asp-controller="Home" asp-fragment="kontakt">Kontakt</a></li>
    </ul>

    <div class="nav-actions">
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a asp-action="Index" asp-controller="@portalController" class="nav-account" aria-label="Gå till din portal">
                <span>@userName</span>
                <i class="fa-solid fa-user"></i>
            </a>
        }
        else
        {
            <a asp-controller="Auth" asp-action="Login" class="nav-login">Logga in</a>
        }

        <button id="menuBtn" class="menu-trigger" type="button" aria-label="Öppna meny">
            <i class="fa-solid fa-bars"></i>
        </button>
    </div>
</nav>
