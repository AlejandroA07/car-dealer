@{
    var pageTitle = string.IsNullOrWhiteSpace(ViewData["Title"]?.ToString())
        ? "Westcoast Cars"
        : $"{ViewData["Title"]} | Westcoast Cars";
    var hideChrome = ViewData["HideChrome"] as bool? == true;
}
<!DOCTYPE html>
<html lang="sv">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="~/css/colors.css">
    <link rel="stylesheet" href="~/css/navigation.css">
    <link rel="stylesheet" href="~/css/utilities.css">
    <link rel="stylesheet" href="~/css/gallery-page.css">
    @RenderSection("styles", false)
    <link rel="stylesheet" href="~/css/site.css">
    <link rel="stylesheet" href="~/css/vehicle-detail-page.css">
    <link rel="stylesheet" href="~/css/ui-redesign.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/css/toastr.min.css" />
    <script src="https://kit.fontawesome.com/8dda4e2421.js" crossorigin="anonymous"></script>
    <title>@pageTitle</title>
</head>
<body id="top" class="@(hideChrome ? "chrome-hidden" : string.Empty)">
    @if (!hideChrome)
    {
        <header class="site-header">
            <div class="site-header-shell">
                @await Html.PartialAsync("_Navigation")
            </div>
        </header>
    }

    <main class="site-main">
        @RenderBody()
    </main>

    @if (!hideChrome)
    {
        <footer class="site-footer">
            <div class="site-container site-footer-content">
                <div class="site-footer-brand">
                    <p class="site-footer-title">Westcoast Cars</p>
                    <p>En lugnare bilaffär med tydliga val, personlig service och kurerat lager.</p>
                </div>

                <div class="site-footer-group">
                    <h2>Snabblänkar</h2>
                    <a asp-action="Index" asp-controller="Home" asp-fragment="kontakt">Kontakt</a>
                    <a asp-route="VehicleCatalog">Katalog</a>
                </div>

                <div class="site-footer-group">
                    <h2>Juridiskt</h2>
                    <a href="#">Integritetspolicy</a>
                    <a href="#">Villkor</a>
                </div>

                <div class="site-footer-meta">
                    <p>© 2026 Westcoast Cars. Nordisk enkelhet.</p>
                    <div class="site-footer-icons" aria-label="Kontaktvägar">
                        <a href="#plats" aria-label="Visa plats"><i class="fa-solid fa-globe"></i></a>
                        <a href="mailto:info@westcoast-cars.com" aria-label="Skicka e-post"><i class="fa-solid fa-envelope"></i></a>
                    </div>
                </div>
            </div>
        </footer>

        <a href="#top" class="scroll-top-button" aria-label="Till toppen">
            <i class="fa-solid fa-chevron-up"></i>
        </a>

        <div id="sidebarOverlay" class="sidebar-overlay"></div>
        <aside id="sidebar" class="sidebar" aria-hidden="true">
            <button id="closeBtn" class="close-btn" type="button" aria-label="Stäng meny">&times;</button>
            <div class="sidebar-brand">
                <span class="brand-kicker">Westcoast Cars</span>
                <h2>Snabbmeny</h2>
            </div>
            <ul class="sidebar-links">
                <li><a asp-action="Index" asp-controller="Home"><i class="fa-solid fa-house"></i> Hem</a></li>
                <li><a asp-route="VehicleCatalog"><i class="fa-solid fa-car"></i> Katalog</a></li>
                <li><a asp-action="Index" asp-controller="Service"><i class="fa-solid fa-wrench"></i> Service</a></li>
                <li><a asp-action="Index" asp-controller="Home" asp-fragment="kontakt"><i class="fa-solid fa-envelope"></i> Kontakt</a></li>
                @if (User.IsInRole("Admin") || User.IsInRole("Salesperson"))
                {
                    <li><a asp-action="Index" asp-controller="Admin"><i class="fa-solid fa-chart-line"></i> Översikt</a></li>
                }
            </ul>

            <div class="sidebar-auth">
                @if (User.Identity?.IsAuthenticated != true)
                {
                    <a asp-action="Login" asp-controller="Auth"><i class="fa-solid fa-right-to-bracket"></i> Logga in</a>
                }
                else
                {
                    <form asp-controller="Auth" asp-action="Logout" method="post" style="margin: 0;">
                        <button type="submit" class="sidebar-logout-btn">
                            <i class="fa-solid fa-right-from-bracket"></i> Logga ut
                        </button>
                    </form>
                }
            </div>
        </aside>
    }

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/js/toastr.min.js"></script>
    @if (!hideChrome)
    {
        <script src="~/js/navigation.js"></script>
    }
    @await Html.PartialAsync("_Notification")
    @RenderSection("Scripts", required: false)
</body>
</html>
