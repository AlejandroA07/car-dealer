@model WestcoastCars.Web.ViewModels.Vehicles.VehicleBaseViewModel

@{
    ViewData["Title"] = "Uppdatera bil";
}

<section class="admin-editor-page">
    <div class="site-container admin-workspace-container">
        @await Html.PartialAsync("_AdminSidebar")

        <main class="admin-workspace-main vehicle-editor-main">
            <header class="vehicle-editor-header">
                <div>
                    <span class="vehicle-editor-kicker">Lagerhantering</span>
                    <h1>Uppdatera bil</h1>
                    <p>Ändra specifikationer, pris och bildinformation. Uppdateringen påverkar katalogen direkt när du sparar.</p>
                </div>
            </header>

            <form asp-action="Edit" asp-route-id="@Model.Vehicle.Id" method="post" enctype="multipart/form-data" class="vehicle-editor-form">
                <input asp-for="Vehicle.Id" type="hidden" />
                <input asp-for="Vehicle.RegistrationNumber" type="hidden" />

                <div asp-validation-summary="All" class="vehicle-editor-validation"></div>

                <section class="vehicle-editor-card">
                    <div class="vehicle-editor-section-title">
                        <i class="fa-solid fa-circle-info"></i>
                        <h2>Primära detaljer</h2>
                    </div>

                    <div class="vehicle-editor-grid">
                        <label class="vehicle-editor-field">
                            <span>Registreringsnummer</span>
                            <output>@Model.Vehicle.RegistrationNumber</output>
                        </label>

                        <label class="vehicle-editor-field">
                            <span>Tillverkare</span>
                            <select asp-for="Vehicle.ManufacturerId" asp-items="Model.Manufacturers"></select>
                            <span class="vehicle-editor-error" asp-validation-for="Vehicle.ManufacturerId"></span>
                        </label>

                        <label class="vehicle-editor-field">
                            <span>Modell</span>
                            <input asp-for="Vehicle.Model" placeholder="t.ex. XC90 Recharge" />
                            <span class="vehicle-editor-error" asp-validation-for="Vehicle.Model"></span>
                        </label>

                        <label class="vehicle-editor-field">
                            <span>Årsmodell</span>
                            <input asp-for="Vehicle.ModelYear" type="number" min="1900" max="@(DateTime.UtcNow.Year + 1)" placeholder="2024" inputmode="numeric" />
                            <span class="vehicle-editor-error" asp-validation-for="Vehicle.ModelYear"></span>
                        </label>

                        <label class="vehicle-editor-field">
                            <span>Pris</span>
                            <input asp-for="Vehicle.Price" placeholder="0" inputmode="numeric" />
                            <span class="vehicle-editor-error" asp-validation-for="Vehicle.Price"></span>
                        </label>

                        <label class="vehicle-editor-toggle">
                            <input asp-for="Vehicle.IsSold" type="checkbox" />
                            <span>
                                <strong>Markerad som såld</strong>
                                <small>Aktivera endast om bilen inte längre ska visas som tillgänglig.</small>
                            </span>
                        </label>
                    </div>
                </section>

                <section class="vehicle-editor-bento">
                    <div class="vehicle-editor-card vehicle-editor-card-muted">
                        <div class="vehicle-editor-section-title">
                            <i class="fa-solid fa-sliders"></i>
                            <h2>Teknisk information</h2>
                        </div>

                        <div class="vehicle-editor-grid compact">
                            <label class="vehicle-editor-field">
                                <span>Bränsletyp</span>
                                <select asp-for="Vehicle.FuelTypeId" asp-items="Model.FuelTypes"></select>
                                <span class="vehicle-editor-error" asp-validation-for="Vehicle.FuelTypeId"></span>
                            </label>

                            <label class="vehicle-editor-field">
                                <span>Växellåda</span>
                                <select asp-for="Vehicle.TransmissionTypeId" asp-items="Model.TransmissionTypes"></select>
                                <span class="vehicle-editor-error" asp-validation-for="Vehicle.TransmissionTypeId"></span>
                            </label>

                            <label class="vehicle-editor-field">
                                <span>Miltal</span>
                                <input asp-for="Vehicle.Mileage" placeholder="45000" inputmode="numeric" />
                                <span class="vehicle-editor-error" asp-validation-for="Vehicle.Mileage"></span>
                            </label>
                        </div>
                    </div>

                    <aside class="vehicle-editor-highlight-card">
                        <h2>Snabba markörer</h2>
                        <div class="vehicle-editor-chip-list">
                            <span>Premium</span>
                            <span>Kontrollerad</span>
                            <span>Redo för visning</span>
                            <button type="button">+ Lägg till</button>
                        </div>
                        <p>Markörer är visuella platshållare tills filter/taggar finns i backend.</p>
                    </aside>
                </section>

                <section class="vehicle-editor-card">
                    <div class="vehicle-editor-section-title">
                        <i class="fa-solid fa-car-side"></i>
                        <h2>Ytterligare detaljer</h2>
                    </div>

                    <div class="vehicle-editor-grid">
                        <label class="vehicle-editor-field">
                            <span>Färg</span>
                            <input asp-for="Vehicle.Color" placeholder="t.ex. Svart" />
                        </label>

                        <label class="vehicle-editor-field">
                            <span>Drivning</span>
                            <input asp-for="Vehicle.WheelDrive" placeholder="t.ex. AWD, FWD, RWD" />
                        </label>

                        <label class="vehicle-editor-field">
                            <span>Effekt (hk)</span>
                            <input asp-for="Vehicle.Horsepower" type="number" min="0" placeholder="t.ex. 150" inputmode="numeric" />
                        </label>

                        <label class="vehicle-editor-field">
                            <span>Karosseri</span>
                            <input asp-for="Vehicle.BodyType" placeholder="t.ex. SUV, Sedan, Kombi" />
                        </label>

                        <label class="vehicle-editor-field">
                            <span>Antal dörrar</span>
                            <input asp-for="Vehicle.Doors" type="number" min="1" max="10" placeholder="t.ex. 5" inputmode="numeric" />
                        </label>

                        <label class="vehicle-editor-field">
                            <span>Motorvolym</span>
                            <input asp-for="Vehicle.EngineVolume" placeholder="t.ex. 2.0L" />
                        </label>

                        <label class="vehicle-editor-field">
                            <span>Stad</span>
                            <input asp-for="Vehicle.City" placeholder="t.ex. Göteborg" />
                        </label>

                        <label class="vehicle-editor-field">
                            <span>Adress</span>
                            <input asp-for="Vehicle.Address" placeholder="t.ex. Storgatan 1" />
                        </label>

                        <label class="vehicle-editor-field">
                            <span>Antal säten</span>
                            <input asp-for="Vehicle.Seats" type="number" min="1" max="20" placeholder="t.ex. 5" inputmode="numeric" />
                        </label>

                        <label class="vehicle-editor-field">
                            <span>Max släpvagnsvikt (kg)</span>
                            <input asp-for="Vehicle.MaxTrailerWeight" type="number" min="0" placeholder="t.ex. 1500" inputmode="numeric" />
                        </label>

                        <label class="vehicle-editor-field">
                            <span>Antal ägare</span>
                            <input asp-for="Vehicle.OwnerCount" type="number" min="1" placeholder="t.ex. 2" inputmode="numeric" />
                        </label>

                        <label class="vehicle-editor-field">
                            <span>Senaste besiktning</span>
                            <input asp-for="Vehicle.LastInspectionDate" type="date" />
                        </label>

                        <label class="vehicle-editor-field">
                            <span>Nästa besiktning</span>
                            <input asp-for="Vehicle.NextInspectionDate" type="date" />
                        </label>
                    </div>

                    <label class="vehicle-editor-field" style="margin-top:1rem">
                        <span>Utrustning (en rad per artikel)</span>
                        <textarea asp-for="Vehicle.Equipment" rows="4" placeholder="Bluetooth&#10;Backkamera&#10;Värmare"></textarea>
                    </label>

                    <label class="vehicle-editor-field" style="margin-top:1rem">
                        <span>Galleri-URL:er (en URL per rad)</span>
                        <textarea asp-for="Vehicle.GalleryUrls" rows="4" placeholder="https://example.com/bild1.jpg&#10;https://example.com/bild2.jpg"></textarea>
                    </label>
                </section>

                <section class="vehicle-editor-card">
                    <div class="vehicle-editor-section-title">
                        <i class="fa-solid fa-pen"></i>
                        <h2>Beskrivning</h2>
                    </div>

                    <label class="vehicle-editor-field">
                        <span>Beskrivning</span>
                        <textarea asp-for="Vehicle.Description" rows="5" placeholder="Beskriv skick, utrustning och det viktigaste kunden bör veta..."></textarea>
                        <span class="vehicle-editor-error" asp-validation-for="Vehicle.Description"></span>
                    </label>
                </section>

                <section class="vehicle-editor-card">
                    <div class="vehicle-editor-gallery-header">
                        <div>
                            <h2>Visuella tillgångar</h2>
                            <p>Använd en bild i 16:9-format för bäst resultat i katalog och detaljsida.</p>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.Vehicle.ImageUrl))
                    {
                        <div class="vehicle-editor-current-image">
                            <img src="@Model.Vehicle.ImageUrl" alt="@Model.Vehicle.Model" />
                        </div>
                    }

                    <label class="vehicle-editor-upload-placeholder" for="ImageFile">
                        <i class="fa-solid fa-cloud-arrow-up"></i>
                        <strong>Ladda upp en ny 16:9-bild</strong>
                        <span>JPEG, PNG, WEBP eller AVIF, max 5 MB. Lämna tomt för att behålla nuvarande bild.</span>
                        <input type="file" asp-for="ImageFile" accept="image/jpeg,image/png,image/webp,image/avif" class="vehicle-editor-upload-input" />
                    </label>
                    <span class="vehicle-editor-error" asp-validation-for="ImageFile"></span>

                    <label class="vehicle-editor-field">
                        <span>Bild-URL (används endast om ingen fil laddas upp ovan)</span>
                        <input asp-for="Vehicle.ImageUrl" placeholder="https://exempel.se/bild.jpg" />
                        <span class="vehicle-editor-error" asp-validation-for="Vehicle.ImageUrl"></span>
                    </label>
                </section>

                <div class="vehicle-editor-actions">
                    <p><i class="fa-solid fa-cloud"></i> Ändringar sparas när du klickar på Spara.</p>
                    <div>
                        <a asp-route="VehicleCatalog" class="btn btn-secondary">Avbryt</a>
                        <button type="submit" class="btn btn-primary">
                            <i class="fa-solid fa-floppy-disk"></i> Spara bil
                        </button>
                    </div>
                </div>
            </form>
        </main>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
