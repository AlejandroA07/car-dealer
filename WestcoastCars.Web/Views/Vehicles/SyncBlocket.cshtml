@model WestcoastCars.Web.ViewModels.Vehicles.BlocketSyncViewModel

@{
    ViewData["Title"] = "Hämta Bilar";
}

<section class="admin-editor-page">
    <div class="site-container admin-workspace-container">
        @await Html.PartialAsync("_AdminSidebar")

        <main class="admin-workspace-main vehicle-editor-main">
            <header class="vehicle-editor-header">
                <div>
                    <span class="vehicle-editor-kicker">Lagerimport</span>
                    <h1>Hämta Bilar</h1>
                    <p>Hämta aktuella Blocket-annonser och uppdatera lagret med en kontrollerad import.</p>
                </div>
            </header>

            <div class="admin-utility-layout">
                <section class="vehicle-editor-card">
                    <div class="vehicle-editor-section-title">
                        <i class="fa-solid fa-rotate"></i>
                        <h2>Manuell upphämtning</h2>
                    </div>

                    <p class="admin-utility-copy">
                        Kör en ny import när lagret behöver uppdateras. Begränsningen skyddar sidan från att hämta för mycket data på en gång.
                    </p>

                    <form asp-action="SyncBlocket" asp-controller="Vehicles" method="post" class="vehicle-editor-form admin-sync-form">
                        @Html.AntiForgeryToken()

                        <label class="vehicle-editor-field">
                            <span>Max antal bilar</span>
                            <input asp-for="Limit" type="number" min="1" max="50" />
                            <span class="vehicle-editor-error" asp-validation-for="Limit"></span>
                        </label>

                        <label class="vehicle-editor-field">
                            <span>Platser</span>
                            <input asp-for="Locations" type="text" placeholder="t.ex. STOCKHOLM" />
                        </label>

                        <label class="vehicle-editor-field">
                            <span>Modeller</span>
                            <input asp-for="Models" type="text" placeholder="t.ex. VOLVO" />
                        </label>

                        <label class="vehicle-editor-field">
                            <span>Organisations-id</span>
                            <input asp-for="OrgId" type="text" placeholder="Valfritt handlare-id" />
                        </label>

                        <label class="vehicle-editor-field">
                            <span>Miltal</span>
                            <select asp-for="MileageBand" class="form-control">
                                <option value="">Alla miltal</option>
                                <option value="0-10000">0 – 10 000 km</option>
                                <option value="10000-20000">10 000 – 20 000 km</option>
                                <option value="20000-30000">20 000 – 30 000 km</option>
                                <option value="30000-40000">30 000 – 40 000 km</option>
                                <option value="40000-">40 000+ km</option>
                            </select>
                        </label>

                        <label class="vehicle-editor-field">
                            <span>Växellåda</span>
                            <select asp-for="TransmissionFilter" class="form-control">
                                <option value="">Alla växellådor</option>
                                <option value="Automat">Automat</option>
                                <option value="Manuell">Manuell</option>
                            </select>
                        </label>

                        <label class="vehicle-editor-field">
                            <span>Bränsletyp</span>
                            <select asp-for="FuelTypeFilter" class="form-control">
                                <option value="">Alla bränsletyper</option>
                                <option value="Bensin">Bensin</option>
                                <option value="Diesel">Diesel</option>
                                <option value="El">El</option>
                                <option value="Hybrid">Hybrid</option>
                                <option value="Laddhybrid">Laddhybrid</option>
                            </select>
                        </label>

                        <div class="vehicle-editor-actions">
                            <button type="submit" class="btn btn-primary">
                                Hämta Bilar
                                <i class="fa-solid fa-arrow-right"></i>
                            </button>
                        </div>
                    </form>
                </section>

                <section class="vehicle-editor-card vehicle-editor-card-muted">
                    <div class="vehicle-editor-section-title">
                        <i class="fa-solid fa-list-check"></i>
                        <h2>Senaste resultat</h2>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.InfoMessage))
                    {
                        <p class="admin-utility-copy">@Model.InfoMessage</p>
                    }
                    else if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
                    {
                        <p class="vehicle-editor-validation">@Model.ErrorMessage</p>
                    }
                    else if (Model.HasResult)
                    {
                        <div class="admin-sync-stats">
                            <div class="admin-sync-stat">
                                <span>Tillagda</span>
                                <strong>@Model.TotalAdded</strong>
                            </div>
                            <div class="admin-sync-stat">
                                <span>Uppdaterade</span>
                                <strong>@Model.TotalUpdated</strong>
                            </div>
                            <div class="admin-sync-stat">
                                <span>Borttagna</span>
                                <strong>@Model.TotalFlagged</strong>
                            </div>
                            <div class="admin-sync-stat">
                                <span>Överhoppade</span>
                                <strong>@Model.TotalSkipped</strong>
                            </div>
                            <div class="admin-sync-stat">
                                <span>Sidor</span>
                                <strong>@Model.PagesFetched</strong>
                            </div>
                        </div>

                        <ul class="admin-sync-summary">
                            <li><span>Begärd gräns</span><strong>@Model.RequestedLimit</strong></li>
                            <li><span>Använd gräns</span><strong>@Model.AppliedLimit</strong></li>
                            <li><span>Hämtade från API</span><strong>@Model.TotalFetched</strong></li>
                            <li><span>Förberedda för import</span><strong>@Model.TotalPrepared</strong></li>
                        </ul>
                    }
                    else
                    {
                        <p class="admin-utility-copy">Ingen upphämtning har körts från den här sidan ännu.</p>
                    }
                </section>
            </div>
        </main>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var form = document.querySelector('.admin-sync-form');
            if (form) {
                form.addEventListener('submit', function () {
                    var btn = form.querySelector('button[type="submit"]');
                    if (btn) {
                        btn.disabled = true;
                        btn.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin"></i> Hämtar...';
                    }
                    if (typeof toastr !== 'undefined') {
                        toastr.info('Hämtar från Blocket, det kan ta 15–30 sekunder…', 'Synkar', {
                            timeOut: 0,
                            extendedTimeOut: 0,
                            closeButton: false,
                            tapToDismiss: false,
                            progressBar: false
                        });
                    }
                });
            }

            if (typeof toastr !== 'undefined') {
                @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage)) {
                    @:toastr.error(@Json.Serialize(Model.ErrorMessage), 'Fel');
                } else if (!string.IsNullOrWhiteSpace(Model.InfoMessage)) {
                    @:toastr.info(@Json.Serialize(Model.InfoMessage), 'Info');
                } else if (Model.HasResult) {
                    @:toastr.success('Synken är klar. @Model.TotalAdded tillagda, @Model.TotalUpdated uppdaterade, @Model.TotalFlagged borttagna.', 'Klart');
                }
            }
        }());
    </script>
}
