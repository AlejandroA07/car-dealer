@model WestcoastCars.Web.ViewModels.Vehicles.VehicleListViewModel
@{
    ViewData["Title"] = "Katalog";
}

<section class="catalog-page">
    <div class="site-container">
        <header class="catalog-header">
            <div>
                <span class="eyebrow">Vårt lager</span>
                <h1>Bil-katalog</h1>
                <p>
                    Utforska aktuella bilar med tydliga filter, lugna kort och snabb väg till detaljerna.
                </p>
            </div>
            <div class="catalog-header-actions">
                @if (User.IsInRole("Admin"))
                {
                    <form asp-action="SeedVehicles" asp-controller="Vehicles" method="post" style="display:contents">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-secondary btn-sm">
                            <i class="fa-solid fa-database"></i> Seeda bilar
                        </button>
                    </form>
                }
                @if (User.IsInRole("Admin") || User.IsInRole("Salesperson"))
                {
                    <a asp-action="Index" asp-controller="Vehicles" asp-route-IsSold="true" class="btn btn-secondary btn-sm">Sålda bilar</a>
                }
                <div class="results-pill">@Model.TotalVehicles bilar</div>
            </div>
        </header>

        @await Html.PartialAsync("_SearchForm", Model)

        @if (!Model.Vehicles.Any())
        {
            <div class="empty-state card-surface catalog-empty-state">
                <span class="eyebrow">Inga träffar</span>
                <h2>Inga bilar matchade din sökning</h2>
                <p>Testa att bredda filtren eller rensa sökningen för att se hela lagret igen.</p>
                <a asp-route="VehicleCatalog" class="btn btn-primary">Visa alla bilar</a>
            </div>
        }
        else
        {
            <div class="vehicle-grid catalog-grid">
                @foreach (var vehicle in Model.Vehicles)
                {
                    @await Html.PartialAsync("_VehicleCard", vehicle)
                }
            </div>

            @if (Model.TotalPages > 1)
            {
                <nav class="catalog-pagination" aria-label="Sidnavigering">
                    <a class="pagination-link pagination-arrow @(Model.HasPreviousPage ? null : "disabled")"
                       asp-route="VehicleCatalog"
                       asp-route-page="@(Model.CurrentPage - 1)"
                       asp-route-Make="@Model.Search.Make"
                       asp-route-Model="@Model.Search.Model"
                       asp-route-MinYear="@Model.Search.MinYear"
                       asp-route-MaxYear="@Model.Search.MaxYear"
                       asp-route-MinPrice="@Model.Search.MinPrice"
                       asp-route-MaxPrice="@Model.Search.MaxPrice"
                       aria-label="Föregående sida">
                        <i class="fa-solid fa-chevron-left"></i>
                    </a>

                    @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
                    {
                        <a class="pagination-link @(pageNumber == Model.CurrentPage ? "active" : null)"
                           asp-route="VehicleCatalog"
                           asp-route-page="@pageNumber"
                           asp-route-Make="@Model.Search.Make"
                           asp-route-Model="@Model.Search.Model"
                           asp-route-MinYear="@Model.Search.MinYear"
                           asp-route-MaxYear="@Model.Search.MaxYear"
                           asp-route-MinPrice="@Model.Search.MinPrice"
                           asp-route-MaxPrice="@Model.Search.MaxPrice">
                            @pageNumber
                        </a>
                    }

                    <a class="pagination-link pagination-arrow @(Model.HasNextPage ? null : "disabled")"
                       asp-route="VehicleCatalog"
                       asp-route-page="@(Model.CurrentPage + 1)"
                       asp-route-Make="@Model.Search.Make"
                       asp-route-Model="@Model.Search.Model"
                       asp-route-MinYear="@Model.Search.MinYear"
                       asp-route-MaxYear="@Model.Search.MaxYear"
                       asp-route-MinPrice="@Model.Search.MinPrice"
                       asp-route-MaxPrice="@Model.Search.MaxPrice"
                       aria-label="Nästa sida">
                        <i class="fa-solid fa-chevron-right"></i>
                    </a>
                </nav>
            }
        }
    </div>
</section>
