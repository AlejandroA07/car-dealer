@model WestcoastCars.Contracts.DTOs.VehicleDetailsDto
@{
    ViewData["Title"] = $"{Model.Manufacturer} {Model.Model}";
    var title = Model.Name?.Trim() ?? string.Empty;
    if (!string.IsNullOrWhiteSpace(Model.Manufacturer) &&
        !title.StartsWith(Model.Manufacturer, StringComparison.OrdinalIgnoreCase))
    {
        title = $"{Model.Manufacturer} {title}".Trim();
    }
    if (string.IsNullOrWhiteSpace(title)) title = Model.Model;
    var colorText = string.IsNullOrWhiteSpace(Model.Color) ? "Ej angivet" : Model.Color;
    var cityText = string.IsNullOrWhiteSpace(Model.City) ? "Göteborg" : Model.City;

    var imageList = new List<string>();
    if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
        imageList.Add(Model.ImageUrl);
    // When ImageUrls is added to the DTO, replace the above with: imageList = Model.ImageUrls;

    var hasExtraImages = imageList.Count > 1;
    var hasMoreOverflow = imageList.Count > 4;
    var thumbCount = hasMoreOverflow ? 3 : imageList.Count - 1;
    var moreCount = imageList.Count - 4;
}

<section class="vehicle-details-page">
    <div class="site-container vehicle-details-container">
        <section class="details-hero-grid" aria-labelledby="vehicle-title">
            <div class="details-gallery">
                <div class="details-main-image">
                    <img src="@imageList[0]" alt="@title" class="gallery-img" />
                    <span class="details-cert-chip">Nordiskt certifierad</span>
                </div>

                @if (hasExtraImages)
                {
                    <div class="details-thumbs" aria-label="Bildöversikt">
                        @for (int i = 1; i <= thumbCount; i++)
                        {
                            <div class="details-thumb">
                                <img src="@imageList[i]" alt="@title bild @(i + 1)" class="gallery-img" />
                            </div>
                        }
                        @if (hasMoreOverflow)
                        {
                            <div class="details-thumb details-thumb-more" data-overflow-index="4">
                                <img src="@imageList[3]" alt="" class="gallery-img" />
                                <span>+@moreCount bilder</span>
                            </div>
                        }
                    </div>
                }
            </div>

            <aside class="details-buy-box" aria-label="Pris och nästa steg">
                <p class="details-maker">@Model.Manufacturer</p>
                <h1 id="vehicle-title">@title</h1>
                <p class="details-subtitle">@Model.ModelYear · @colorText</p>

                <div class="details-price-block">
                    <strong>@Model.Price.ToString("N0") kr</strong>
                    <span>Exklusive skatt och registreringsavgift</span>
                </div>

                <div class="details-action-stack">
                    <a href="/#kontakt" class="btn btn-primary btn-full">
                        Kontakta oss <i class="fa-regular fa-envelope"></i>
                    </a>
                    @if (!string.IsNullOrWhiteSpace(Model.SourceUrl))
                    {
                        <a href="@Model.SourceUrl" target="_blank" rel="noopener noreferrer" class="details-source-link">
                            Visa originalannons <i class="fa-solid fa-arrow-up-right-from-square"></i>
                        </a>
                    }
                </div>

                <div class="details-trust-box">
                    <i class="fa-solid fa-certificate"></i>
                    <div>
                        <strong>Westcoast kvalitetssäkrad</strong>
                        <p>Den här bilen är presenterad med tydliga fakta och personlig hjälp från första kontakt.</p>
                    </div>
                </div>
            </aside>
        </section>

        <section class="details-lower-grid">
            <div class="details-main-content">
                <section class="details-spec-section" aria-labelledby="details-spec-title">
                    <h2 id="details-spec-title">Tekniska specifikationer</h2>
                    <div class="details-spec-grid">
                        <article><span>År</span><strong>@Model.ModelYear</strong></article>
                        <article><span>Miltal</span><strong>@Model.Mileage.ToString("N0") km</strong></article>
                        <article><span>Bränsle</span><strong>@Model.FuelType</strong></article>
                        <article><span>Växellåda</span><strong>@Model.TransmissionType</strong></article>
                        <article><span>Färg</span><strong>@colorText</strong></article>
                        @if (!string.IsNullOrWhiteSpace(Model.RegistrationNumber))
                        {
                            <article><span>Regnr</span><strong>@Model.RegistrationNumber</strong></article>
                        }
                    </div>
                </section>

                <section class="details-description-block" aria-labelledby="details-description-title">
                    <h2 id="details-description-title">Beskrivning</h2>
                    <p>@(string.IsNullOrWhiteSpace(Model.Description) ? "Ingen beskrivning tillgänglig ännu. Kontakta oss så hjälper vi dig med mer information om bilen." : Model.Description)</p>

                    <div class="details-feature-row">
                        <article>
                            <i class="fa-solid fa-shield-halved"></i>
                            <div>
                                <strong>Trygg affär</strong>
                                <span>Tydlig information före kontakt</span>
                            </div>
                        </article>
                        <article>
                            <i class="fa-solid fa-headset"></i>
                            <div>
                                <strong>Personlig hjälp</strong>
                                <span>Rådgivning hela vägen</span>
                            </div>
                        </article>
                    </div>
                </section>

                @if (Model.Equipment.Count > 0)
                {
                    <section class="details-equipment-section" aria-labelledby="details-equipment-title">
                        <h2 id="details-equipment-title">Utrustning</h2>
                        <ul class="details-equipment-list">
                            @foreach (var item in Model.Equipment)
                            {
                                <li>@item</li>
                            }
                        </ul>
                    </section>
                }
            </div>

            <aside class="details-side-stack">
                <section class="details-location-card" aria-labelledby="details-location-title">
                    <h2 id="details-location-title">Plats</h2>
                    <a href="https://maps.google.com/maps?q=@Uri.EscapeDataString(cityText)"
                       target="_blank" rel="noopener noreferrer" class="details-map-preview-link" aria-label="Öppna @cityText i Google Maps">
                        <div class="details-map-preview" aria-hidden="true">
                            <i class="fa-solid fa-location-dot"></i>
                        </div>
                    </a>
                    <p>@cityText</p>
                </section>

                <section class="details-assurance-card" aria-labelledby="details-assurance-title">
                    <h2 id="details-assurance-title">Westcoast trygghet</h2>
                    <ul>
                        <li><i class="fa-solid fa-shield-halved"></i><span><strong>Kontrollerad information</strong>Pris, status och fakta visas tidigt.</span></li>
                        <li><i class="fa-solid fa-rotate-left"></i><span><strong>Rak kontakt</strong>Vi hjälper dig snabbt vidare utan onödigt brus.</span></li>
                        <li><i class="fa-solid fa-truck-fast"></i><span><strong>Smidig leverans</strong>Vi planerar hämtning eller överlämning tillsammans.</span></li>
                    </ul>
                </section>
            </aside>
        </section>
    </div>
</section>

<div id="lightbox" class="lightbox-overlay" role="dialog" aria-modal="true" aria-label="Bildvisare">
    <button class="lightbox-close" aria-label="Stäng">&times;</button>
    <button class="lightbox-prev" aria-label="Föregående bild">&#8249;</button>
    <div class="lightbox-content">
        <img id="lightbox-img" src="" alt="" />
        <p id="lightbox-counter" class="lightbox-counter"></p>
    </div>
    <button class="lightbox-next" aria-label="Nästa bild">&#8250;</button>
</div>

<script>
    (function () {
        var images = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(imageList));
        var overlay = document.getElementById('lightbox');
        var img = document.getElementById('lightbox-img');
        var counter = document.getElementById('lightbox-counter');
        var current = 0;

        function openAt(index) {
            current = Math.max(0, Math.min(index, images.length - 1));
            img.src = images[current];
            img.alt = '@Html.Raw(title.Replace("'", "\\'")) bild ' + (current + 1);
            counter.textContent = images.length > 1 ? (current + 1) + ' / ' + images.length : '';
            overlay.classList.add('is-open');
            document.body.style.overflow = 'hidden';
        }

        function close() {
            overlay.classList.remove('is-open');
            document.body.style.overflow = '';
        }

        function prev() { openAt((current - 1 + images.length) % images.length); }
        function next() { openAt((current + 1) % images.length); }

        // Attach click to all gallery images in DOM order
        var galleryImgs = document.querySelectorAll('.gallery-img');
        galleryImgs.forEach(function (el, idx) {
            el.style.cursor = 'pointer';
            el.addEventListener('click', function () {
                // For the overflow thumb, open at overflow start index
                var overflowParent = el.closest('[data-overflow-index]');
                var openIndex = overflowParent ? parseInt(overflowParent.dataset.overflowIndex) : idx;
                openAt(openIndex);
            });
        });

        document.querySelector('.lightbox-close').addEventListener('click', close);
        document.querySelector('.lightbox-prev').addEventListener('click', prev);
        document.querySelector('.lightbox-next').addEventListener('click', next);
        overlay.addEventListener('click', function (e) { if (e.target === overlay) close(); });
        document.addEventListener('keydown', function (e) {
            if (!overlay.classList.contains('is-open')) return;
            if (e.key === 'Escape') close();
            if (e.key === 'ArrowLeft') prev();
            if (e.key === 'ArrowRight') next();
        });

        if (images.length <= 1) {
            document.querySelector('.lightbox-prev').style.display = 'none';
            document.querySelector('.lightbox-next').style.display = 'none';
        }
    })();
</script>
