@model WestcoastCars.Web.ViewModels.Vehicles.VehicleListViewModel
@{
    ViewData["Title"] = "Hem";
}

<section class="home-hero" aria-labelledby="home-hero-title">
    <div class="home-hero-media">
        <picture>
            <source srcset="~/images/landing.webp" type="image/webp" />
            <img src="~/images/landing.jpg" alt="Westcoast Cars bilhall med utvalda bilar" width="1920" height="1280" fetchpriority="high" decoding="async" />
        </picture>
        <div class="home-hero-overlay"></div>
    </div>

    <div class="home-hero-content site-container">
        <div class="home-hero-copy">
            <span class="eyebrow">Kurerad bilhandel på västkusten</span>
            <h1 id="home-hero-title">Trygga bilaffärer med nordisk enkelhet.</h1>
            <p>
                Vi hjälper dig hitta rätt bil med tydlig information, noggrant utvalda fordon och personlig service från första klick till provkörning.
            </p>
            <div class="hero-actions">
                <a asp-route="VehicleCatalog" class="btn btn-primary">
                    Utforska lager <i class="fa-solid fa-arrow-right"></i>
                </a>
                <a asp-action="Index" asp-controller="Service" class="btn btn-secondary">Boka service</a>
            </div>
        </div>
    </div>
</section>

<section id="utvalda-bilar" class="selection-section">
    <div class="site-container">
        <div class="section-heading section-heading-spacious">
            <div>
                <span class="eyebrow">Utvalt lager</span>
                <h2>Utvalda bilar</h2>
                <p class="section-description">Bild först, tydligt pris och minimalt brus — så blir det enklare att jämföra rätt bil.</p>
            </div>
            <a asp-route="VehicleCatalog" class="text-link">Se hela lagret <i class="fa-solid fa-arrow-up-right-from-square"></i></a>
        </div>

        @if (!Model.Vehicles.Any())
        {
            <div class="empty-state card-surface">
                <h3>Inga utvalda bilar att visa just nu</h3>
                <p>När lagret uppdateras visas de första utvalda bilarna här.</p>
                <a asp-route="VehicleCatalog" class="btn btn-primary">Gå till lager</a>
            </div>
        }
        else
        {
            <div class="vehicle-grid vehicle-grid-featured">
                @foreach (var vehicle in Model.Vehicles)
                {
                    @await Html.PartialAsync("_VehicleCard", vehicle)
                }
            </div>
        }
    </div>
</section>

<section id="kontakt" class="location-section site-container">
    <a href="https://www.google.com/maps/place/Annebergsgatan+25,+214+66+Malm%C3%B6"
       target="_blank" rel="noopener noreferrer" class="location-map-link" aria-label="Öppna Annebergsgatan 25 i Google Maps">
        <div class="location-map">
            <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
        </div>
    </a>

    <div class="location-copy">
        <span class="eyebrow">Kontakt</span>
        <h2>Besök vår bilhall eller hör av dig direkt.</h2>
        <p>
            Kom förbi för att se aktuella bilar, prata med oss om nästa steg eller boka en personlig genomgång.
        </p>
        <p class="location-contact-label">eller kontakta oss på</p>
        <div class="location-contact-links">
            <a href="mailto:västkusten.bilar@gmail.com" class="location-contact-item">
                <i class="fa-regular fa-envelope"></i>
                västkusten.bilar@gmail.com
            </a>
            <a href="tel:+46720392470" class="location-contact-item">
                <i class="fa-solid fa-phone"></i>
                +46 720 392 470
            </a>
        </div>
    </div>
</section>
